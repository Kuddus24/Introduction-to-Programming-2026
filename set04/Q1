// The file inps.dat contains student records. The first line specifies the number of records, and
// each of the subsequent lines contains a student’s name, roll number, and marks. Perform the
// following tasks:
// (a) Define a structure with fields for the student’s name, roll number, and marks, and create
// an array of such structures.
// (b) Write a routine to populate the array by reading input from stdin in the same format
// as inps.dat.
// (c) Write a routine to print the contents of the array in the format of inps.dat.
// (d) Sort the array based on each of the three fields using any sorting algorithm of your choice.
// 2. Repeat all of the above tasks assuming that the array stores pointers to structures instead of
// structures themselves.

#include<stdio.h>
#include<string.h>
#define MAX 100


typedef struct{
    char name[50];
    char roll[20];
    int marks;
}Student;

//Read student;
void ReadStudents(Student students[], int n){
    for(int i=0; i<n; i++){
        scanf("%s %s %d",students[i].name,students[i].roll,&students[i].marks);
    }
}


//Print students
void PrintStudents(Student students[], int n){
    for(int i =0;i<n;i++){
        printf("%s %s %d\n",students[i].name,students[i].roll,students[i].marks);
    }
}

//For sorting we use most simplest sorting that is bubble sort
//Sort according to name;
void SortbyName(Student students[], int n){
    Student temp;
    for(int i =0;i<n-1;i++){
        for(int j=0;j<n-i-1;j++){
            if(strcmp(students[j].name,students[j+1].name)>0)
            {
                temp=students[j];
                students[j]=students[j+1];
                students[j+1]= temp;
            }

        }
    }
}

//sort according to roll
void SortbyRoll(Student students[],int n){
    Student temp;
    for(int i=0;i<n-1;i++){
        for(int j=0;j<n-i-1;j++){
            if(strcmp(students[j].roll,students[j+1].roll)>0){
                temp=students[j];
                students[j]=students[j+1];
                students[j+1]=temp;
            }
        }
    }

}

// Sort according to marks
void sortByMarks(Student students[], int n)
{
    Student temp;

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (students[j].marks >
                students[j + 1].marks)
            {
                temp = students[j];
                students[j] = students[j + 1];
                students[j + 1] = temp;
            }
        }
    }
}


int main(){

    Student students[MAX];
    int n;
    //number of students;
    scanf("%d",&n);
    //Read data
    ReadStudents(students,n);

    //Original records
    printf("\nOriginal records: \n");
    PrintStudents(students,n);

    //sort by name
    SortbyName(students,n);
    printf("\nSorted by name\n");
    PrintStudents(students,n);

    //Sort by roll
    SortbyRoll(students,n);
    printf("\nSorted by roll numbers\n");
    PrintStudents(students,n);

    //Sort by marks;
    sortByMarks(students,n);
    printf("\nSorteb by marks\n");
    PrintStudents(students,n);


    
    return 0;
}





// 2. Repeat all of the above tasks assuming that the array stores pointers to structures instead of
// structures themselves.
#include<stdio.h>
#include<string.h>
#include<stdlib.h>
#define MAX 100

typedef struct{
    char name[50];
    char roll[20];
    int marks;
}Student;

//Read Students
void readStudents(Student *students[],int n){
    for(int i =0;i<n;i++){
        scanf("%s %s %d",students[i]->name,students[i]->roll,&students[i]->marks);
    }

}
//print students;
void printStudents(Student *students[], int n){
    for(int i =0;i<n ;i++){
        printf("%s %s %d\n",students[i]->name,students[i]->roll, students[i]->marks);
    }
}

//Store by name;
void sortByName(Student *students[], int n){
    for(int i =0;i<n-1;i++){
        for(int j =0;j<n-i-1;j++){
            if(strcmp(students[j]->name,students[j+1]->name)>0){
                Student *temp;
                temp = students[j];
                students[j] = students[j+1];
                students[j+1]= temp;
            }
        }
    }
}

// Sort by roll number
void sortByRoll(Student *students[], int n)
{
    Student *temp;

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (strcmp(students[j]->roll,
                       students[j + 1]->roll) > 0)
            {
                // Swap pointers
                temp = students[j];
                students[j] = students[j + 1];
                students[j + 1] = temp;
            }
        }
    }
}


// Sort by marks
void sortByMarks(Student *students[], int n)
{
    Student *temp;

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (students[j]->marks >
                students[j + 1]->marks)
            {
                // Swap pointers
                temp = students[j];
                students[j] = students[j + 1];
                students[j + 1] = temp;
            }
        }
    }
}

int main(){
    int n;
    scanf("%d",&n);
    Student *students[MAX];
    
    //dynamically allocate each student;
    for(int i=0;i<n;i++){
        students[i]=malloc(sizeof(Student));

        if(students[i]==NULL){
            printf("Memory allocation is failed.\n");
            return 1;
        }
    }


    // Read student data
    readStudents(students, n);


    // Original records
    printf("\nOriginal records:\n");
    printStudents(students, n);


    // Sort by name
    sortByName(students, n);

    printf("\nSorted by name:\n");
    printStudents(students, n);


    // Sort by roll
    sortByRoll(students, n);

    printf("\nSorted by roll:\n");
    printStudents(students, n);


    // Sort by marks
    sortByMarks(students, n);

    printf("\nSorted by marks:\n");
    printStudents(students, n);


    // Free memory
    for (int i = 0; i < n; i++)
    {
        free(students[i]);
    }
    return 0;
}
