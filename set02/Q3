#include<stdio.h>
#include<ctype.h>

int main(){
    char s[1000];
    printf("Enter encoding string: ");
    scanf("%999s",s);
    int i = 0;
    while(s[i]!='\0'){
        char ch=s[i];
        //print the character atleast once;
        printf("%c",ch);
        i++;
        //if digit follows the character;
        if(isdigit(s[i])){
            int count = 0;
            //convert all consecutive digit into integers;
            while(isdigit(s[i])){
                count = count*10 + (s[i] -'0');
                i++;
            }
            for(int j=1;j<count;j++){       //as we already printed one charater so now we print it in count-1 times;
                printf("%c",ch);
            }
        }
    }
    printf("\n");
    return 0;
}
