// Write a C program to evaluate a postfix expression using a stack implemented with a dy-
// namically resizable array. The input expression will contain integer operands and the binary
// operators + and * representing addition and multiplication respectively. More specifically,
// the input will consists of a sequence of whitespace-separated tokens representing a postfix
// expression. Each token would be an integer (positive or negative) or an operator + or *. The
// input expression would end with EOF. Some example valid inputs are as follows:
// 2 3 + 4 *
// 23 32 + -15 60 + *
// 2 3 + 41 5000 + *
// Note that the above expressions represents the infix expressions (2 + 3) * 4, (23 + 32) * (-15
// + 60), and (2 + 3) * (41 + 5000) respectively.
// For a valid input your program should output an integer which would be the evaluation of
// the given input expression. For invalid inputs, your program should be able to report that
// the input is invalid.

#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<limits.h>

//define structure of stack
typedef struct{
    long long *data;
    int top;
    int capacity;
}Stack;

//Initialize Stack
void initStack(Stack *s){
    s->capacity = 2;
    s->top = 0;
    s->data = malloc(s->capacity*sizeof(long long));
    if(s->data == NULL){
        fprintf(stderr,"Memory allocation failed\n");
        exit(1);
    }
}

/*Push an element*/
int push(Stack *s, long long value){
    //if stack is full , double its size
    if(s->top == s->capacity){
        int newCapacity = s->capacity*2;
        long long *temp = realloc(s->data,newCapacity*sizeof(long long));
        if (temp == NULL){
            return 0;
        }
        s->data = temp;
        s->capacity = newCapacity;
    }
    s->data[s->top]=value;
    s->top++;
    return 1;
}

/*Pop an element*/
int pop(Stack *s, long long *value){
    if(s->top == 0){
        return 0;

    }
    s->top--;
    *value = s->data[s->top];
    return 1;
}

//Free stack memory;
void freeStack(Stack *s){
    free(s->data);
    s->data == NULL;
}

int main(void){
    Stack s;
    char token[100];
    initStack(&s);
    while(scanf("%99s",token)!=EOF){
        //Operator
        if(strcmp(token,"+")==0){
            long long a,b;
            //Need at least two operands;
            if(!pop(&s,&b) || !pop(&s,&a)){
                printf("Invalid input\n");
                freeStack(&s);
                return 0;
            }
            if(!push(&s,a+b)){
                printf("Invalid Input\n");
                freeStack(&s);
                return 0;
            }
        }
        //operator
        else if(strcmp(token,"*")==0){
            long long a,b;
            //Need at least two operands;
            if(!pop(&s,&b) || !pop(&s,&a)){
                printf("Invalid input\n");
                freeStack(&s);
                return 0;
            }
            if(!push(&s,a+b)){
                printf("Invalid Input\n");
                freeStack(&s);
                return 0;
            }
        }
        //Operand
        else{
            char *end;
            long long value;
            value=strtoll(token,&end,10);
            //Token is not a valid integer;
            if(*end!='\0'){
                printf("Invalid Input\n");
                freeStack(&s);
                return 0;
            }
            if(!push(&s,value)){
                printf("Invalid Input\n");
                freeStack(&s);
                return 0;
            }
        }
    }
    if(s.top!=1){
        printf("Invalid Input\n");
        freeStack(&s);
        return 0;
    }
    printf("%lld\n",s.data[0]);
    freeStack(&s);
    return 0;
}





