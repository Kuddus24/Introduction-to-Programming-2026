/* This program demonstrates a variable-length array (VLA) and calculates the sum of squares from 0² to (n-1)²*/


#include<stdio.h>

int main(int ac, char *av[])
{
    int i, n;

    scanf("%d", &n);
    printf("n = %d\n", n);

    int a[n], sum = 0;
    for (i = 0; i < n; i++)
        sum += a[i] = i*i;
    printf("sum = %d\n", sum);
    return 0;
}



/*The key concept here is VLA: int a[n], where the array size is decided at runtime rather than being a compile-time constan*/
