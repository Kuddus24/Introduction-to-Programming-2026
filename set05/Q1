#include<stdio.h>
#include<stdlib.h>

int n;

int add(int a, int b){
	return a + b;
}

int main(){
	int x = 10;
	int y = 27;
	int *p;

	printf("%d\n", add(x,y));
	p = (int *)malloc(10 * sizeof(int));

	printf("Code: function add at  %p\n", (void *)add);
	printf("Code: function main at %p\n", (void *)main);
	printf("Data: variable n at    %p\n", &n);
	printf("Stack: variable x at   %p\n", &x);
	printf("Stack: variable y at   %p\n", &y);
	printf("Stack: variable p at   %p\n", &p);
	printf("Heap:  var p points to %p\n", p);
  free(p);
  return 0;
}

